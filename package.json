{
  "name": "nova-classic",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "next build",
    "deploy": "next build && cd out && git init -b gh-pages && git add . && git commit -m \"deploy: update gh-pages static export\" && git remote add origin https://github.com/nxm310/nova-classic.git && git push -u origin gh-pages --force && rm -rf .git && cd ..",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
